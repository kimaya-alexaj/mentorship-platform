# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (from Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, bypasses RLS. Used only in trusted server
# code (e.g. admin routes guarded by our own role check). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications for requests/matches)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Mentoring Platform <notifications@example.org>"

# Base URL used to build links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
